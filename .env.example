# Copy to .env and point SELFMORPH_MODEL_PATH at a frozen decoder LM.
#   cp .env.example .env
#   set -a; source .env; set +a

# Local path or Hugging Face repo id of the frozen backbone.
SELFMORPH_MODEL_PATH=/path/to/frozen-base-lm

# Default runtime config. Alternatives:
#   config/runtime_qwen35_4b.json
#   config/runtime_gemma4_12b.json
SELFMORPH_RUNTIME_CONFIG=config/runtime.json

SELFMORPH_DATASET_ROOT=resources/datasets
SELFMORPH_EVAL_DATASET_ROOT=resources/eval_datasets

SELFMORPH_ARTIFACTS_DIR=artifacts
SELFMORPH_ORACLE_DIR=${SELFMORPH_ARTIFACTS_DIR}/oracle
SELFMORPH_TRAINING_DATA_DIR=${SELFMORPH_ARTIFACTS_DIR}/training_data
SELFMORPH_CHECKPOINT_DIR=${SELFMORPH_ARTIFACTS_DIR}/checkpoints
SELFMORPH_RESULTS_DIR=${SELFMORPH_ARTIFACTS_DIR}/results
